# Copy this file to .env and fill in your own key. Never commit .env.
# Every agent uses gpt-6-luna through Portkey (https://portkey.ai).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: extra browser origins the backend should allow (comma-separated).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
